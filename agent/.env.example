# Copy to .env.local and fill in from https://cloud.livekit.io -> your project -> Settings -> Keys
#
# These three are the ONLY credentials this project needs. Every model in the voice
# pipeline (Deepgram STT, OpenAI LLM, Inworld TTS) runs through LiveKit Inference, which
# authenticates with these same keys and bills through your LiveKit account.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
